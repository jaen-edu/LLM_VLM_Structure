RUNPOD_API_KEY=

# Pod 기본 구성
RUNPOD_GPU_TYPE=NVIDIA A100 80GB PCIe
RUNPOD_GPU_TYPE_FALLBACKS=NVIDIA A100-SXM4-80GB
RUNPOD_IMAGE_NAME=runpod/pytorch:2.8.0-py3.11-cuda12.8.1-cudnn-devel-ubuntu22.04
RUNPOD_TEMPLATE_ID=
RUNPOD_PORTS=8888/http
RUNPOD_VOLUME_GB=100
RUNPOD_CONTAINER_DISK_GB=100

# Jupyter
RUNPOD_JUPYTER_PORT=8888
RUNPOD_JUPYTER_TOKEN=koreatech123
RUNPOD_JUPYTER_CHECK_TIMEOUT=20

# 운영 튜닝
RUNPOD_RETRY_COUNT=3
RUNPOD_RETRY_DELAY_SECONDS=2
RUNPOD_RATE_LIMIT_SECONDS=1

# 엑셀
RUNPOD_SHEET_NAME=시트1
RUNPOD_CLASS_PREFIX=class
